# URL gốc site (production) — canonical, Open Graph, sitemap, JSON-LD (SEO)
# Ví dụ: https://tamsu-ivf.vn
# Phải có scheme (https:// trên production). Không có dấu / cuối.
# Messenger / Zalo / Facebook: preview cần og:image qua HTTPS + domain công khai (localhost không crawl được).
# Trên Vercel: nếu chưa set biến này, app dùng VERCEL_URL (https) làm fallback.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

# URL project (public, dùng được trên client nếu sau này bạn gọi Supabase trực tiếp)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Key public: JWT anon (eyJ...) HOẶC Publishable default (sb_publishable_...) tùy dashboard
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Service role — CHỈ trên server (.env.local), không commit, không NEXT_PUBLIC_
# Dùng trong Route Handler để ghi/đọc bảng (bỏ qua RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
